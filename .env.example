# ReCare AI - Production Environment Variables Example
# Duplicate this file as .env locally if needed. Never commit .env with real secrets to GitHub.

# Backend Configuration
ENVIRONMENT=production
PORT=8000
DATABASE_URL=sqlite:///./recare_ai.db
LOG_LEVEL=INFO

# Frontend Configuration (Set in Vercel Dashboard Environment Variables)
# Point this to your live Render backend URL:
VITE_API_BASE_URL=https://your-render-backend-url.onrender.com
VITE_API_URL=https://your-render-backend-url.onrender.com
