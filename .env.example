# ReCare AI - Environment Configuration Example

# Backend Database (defaults to SQLite fallback for instant local setup)
# For local SQLite: sqlite:///./recare_ai.db
# For PostgreSQL (Render / Supabase / Neon):
DATABASE_URL=sqlite:///./recare_ai.db

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend API URL (Used by Vite during build & dev)
VITE_API_URL=http://localhost:8000
